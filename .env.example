# Kopie als .env anlegen (wird NICHT eingecheckt) und mit
#   set -a; source .env; set +a
# in die Shell laden.

# --- Server ---
LICHT_HOST=127.0.0.1        # 0.0.0.0 = im Heimnetz erreichbar (Tablet/Smartphone)
LICHT_PORT=8000
LICHT_LOG_LEVEL=info
LICHT_SIMULATION=true       # true = keine echte Hardware ansprechen

# --- Adapter (noch nicht implementiert) ---
HUE_ENABLED=false
CASAMBI_EVOLUTION_ENABLED=false
CASAMBI_CLASSIC_ENABLED=false

# Zugangsdaten folgen später, z.B.:
# HUE_BRIDGE_HOST=
# HUE_APP_KEY=
